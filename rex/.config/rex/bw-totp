#!/usr/bin/env python3
"""Compute current TOTP from a base32 secret or otpauth:// URI on stdin."""
import base64, hashlib, hmac, struct, sys, time, urllib.parse

s = sys.stdin.read().strip()
if s.startswith("otpauth://"):
    s = urllib.parse.parse_qs(urllib.parse.urlparse(s).query).get("secret", [""])[0]
key = base64.b32decode(s.upper() + "=" * (-len(s) % 8))
counter = int(time.time()) // 30
msg = struct.pack(">Q", counter)
h = hmac.new(key, msg, hashlib.sha1).digest()
offset = h[-1] & 0xF
code = (struct.unpack(">I", h[offset : offset + 4])[0] & 0x7FFFFFFF) % 1_000_000
sys.stdout.write(f"{code:06d}")
