{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "figma-desktop": {
        "type": "remote",
        "url": "http://127.0.0.1:3845/mcp",
        "oauth": false,
      },
    },
  },
  "plugins": [
    "@dietrichgebert/ponytail"
  ],
  // Last matching rule wins, so the catch-all stays first.
  "permission": {
    "bash": {
      "*": "allow",
      "git commit*": "deny",
      "git push*": "deny",
      "git merge*": "deny",
      "git rebase*": "deny",
      "git cherry-pick*": "deny",
      "git reset --hard*": "deny",
      "git clean*": "deny",
      "git branch -D*": "deny",
      "git checkout -- *": "ask",
      "git restore*": "ask",
      "git stash drop*": "ask"
    }
  },
}
