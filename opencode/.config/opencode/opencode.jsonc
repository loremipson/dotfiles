{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "figma-desktop": {
        "type": "remote",
        "url": "http://127.0.0.1:3845/mcp",
        "oauth": false,
      },
    },
  },
  "permissions": [
    {
      "action": "atlassian_*",
      "resource": "*",
      "effect": "deny",
    },
    {
      "action": "atlassian_atlassianUserInfo",
      "resource": "*",
      "effect": "allow",
    },
    {
      "action": "atlassian_getAccessibleAtlassianResources",
      "resource": "*",
      "effect": "allow",
    },
    {
      "action": "atlassian_discover",
      "resource": "*",
      "effect": "allow",
    },
    {
      "action": "atlassian_executeRead",
      "resource": "*",
      "effect": "allow",
    },
    {
      "action": "atlassian_getJiraIssue",
      "resource": "*",
      "effect": "allow",
    },
    {
      "action": "atlassian_searchJiraIssuesUsingJql",
      "resource": "*",
      "effect": "allow",
    },
    {
      "action": "atlassian_getConfluenceContent",
      "resource": "*",
      "effect": "allow",
    },
    {
      "action": "atlassian_getGraphContext",
      "resource": "*",
      "effect": "allow",
    },
    {
      "action": "atlassian_getGraphObject",
      "resource": "*",
      "effect": "allow",
    },
    {
      "action": "atlassian_getLoomVideo",
      "resource": "*",
      "effect": "allow",
    },
  ],
  "plugins": [
    "@dietrichgebert/ponytail",
    "./plugins/status"
  ],
  // Last matching rule wins, so the catch-all stays first.
  "permission": {
    "bash": {
      "*": "allow",
      "git commit*": "deny",
      "git push*": "deny",
      "git merge*": "deny",
      "git rebase*": "deny",
      "git cherry-pick*": "deny",
      "git reset --hard*": "deny",
      "git clean*": "deny",
      "git branch -D*": "deny",
      "git checkout -- *": "ask",
      "git restore*": "ask",
      "git stash drop*": "ask"
    }
  },
}
