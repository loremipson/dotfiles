.DS_Store
.localized

# Editors/IDEs
*.swp
*.swo
*~
.idea/
.vscode/
*.code-workspace

# Secrets/sensitive
.env
.env.*
*.key
*.pem
secrets/

# Rex plugins (cloned by ./install rex)
rex/.config/rex/rex-tmux-bindings/
rex/.config/rex/rex-bitwarden/

# Third-party skills (not committed; install manually from their sources)
# impeccable: https://github.com/pbakaus/impeccable (Apache-2.0)
# rex: managed by `rex skill setup` / `rex skill remove`
agents/.agents/skills/impeccable/
agents/.agents/skills/rex/

# Generated/lock files
nvim/.config/nvim/nvim-pack-lock.json

# Dependencies
node_modules/

# General
*.log
*.tmp
*.bak
opencode/.config/opencode/service.json
